{
  "name": "privacy-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest src/**/__tests__/unit",
    "test:integration": "vitest src/**/__tests__/integration",
    "test:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "test": "vitest src/**/__tests__",
    "test:coverage": "vitest run src/**/__tests__ --coverage",
    "test:selenium": "tsx tests/selenium/scan.test.ts",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:check",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:check": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:check": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.12.3",
    "@types/selenium-webdriver": "^4.35.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.1",
    "selenium-webdriver": "^4.43.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
